import numpy as np

# Dataset
X = np.array([1, 2, 3])
Y = np.array([2, 4, 5])

# Learning rate
alpha = 0.01

# Initialize parameters
m = 0
c = 0

# Number of iterations
iterations = 1000

n = len(X)

# Gradient Descent
for i in range(iterations):

    Y_pred = m * X + c

    # Calculate gradients
    dm = (1/n) * np.sum(X * (Y_pred - Y))
    dc = (1/n) * np.sum(Y_pred - Y)

    # Update parameters
    m = m - alpha * dm
    c = c - alpha * dc

    # Calculate cost function
    cost = (1/(2*n)) * np.sum((Y_pred - Y)**2)

# Final output
print("Slope (m):", m)
print("Intercept (c):", c)
print("Final Cost:", cost)

# Prediction
Y_pred = m * X + c
print("Predicted Values:", Y_pred)
