import numpy as np
from scipy import stats
A = np.array([6, 7, 8, 9, 10])
B = np.array([8, 9, 10, 11, 12])
alpha = 0.05
n1 = len(A)
n2 = len(B)
mean1 = np.mean(A)
mean2 = np.mean(B)
var1 = np.var(A, ddof=1)
var2 = np.var(B, ddof=1)
sp2 = ((n1 - 1) * var1 + (n2 - 1) * var2) / (n1 + n2 - 2)
t_stat = (mean1 - mean2) / np.sqrt(
    sp2 * (1/n1 + 1/n2)
)
df = n1 + n2 - 2
p_value = 2 * (1 - stats.t.cdf(abs(t_stat), df))
critical_value = 2.306

print("Two Independent Sample t-Test")
print("--------------------------------")

print("Mean of Model A =", mean1)
print("Mean of Model B =", mean2)

print("Variance of Model A =", var1)
print("Variance of Model B =", var2)

print("Pooled Variance =", sp2)

print("t-statistic =", round(t_stat, 4))
print("Degrees of Freedom =", df)
print("Critical Value = ±", critical_value)
print("p-value =", round(p_value, 4))
if abs(t_stat) > critical_value:
    print("Reject H0")
    print("Population mean errors are significantly different.")
else:
    print("Fail to reject H0")
    print("Population mean errors are not significantly different.")

#A regression model is expected to have a mean absolute error of 5. the mae value of 6 independent cases are 4 5 6 5 7 3at 5% level of sig test whether the population mean mae differs from 5 use one sample t test mean
import math
mae = [4, 5, 6, 5, 7, 3]
mu = 5
n = len(mae)
mean = sum(mae) / n
variance = sum((x - mean) ** 2 for x in mae) / (n - 1)
std = math.sqrt(variance)
t_value = (mean - mu) / (std / math.sqrt(n))
critical_value = 2.571
print("Sample Mean:", mean)
print("Sample Standard Deviation:", std)
print("Calculated t-value:", t_value)
print("Critical value: ±", critical_value)
if abs(t_value) > critical_value:
    print("Reject H0")
    print("Population mean MAE is significantly different from 5.")
else:
    print("Fail to reject H0")
    print("Population mean MAE is not significantly different from 5.")


import math
from scipy.stats import norm
n1 = 36
n2 = 36

x1 = 52
x2 = 49

sigma1 = 6
sigma2 = 6
alpha = 0.05
z = (x1 - x2) / math.sqrt(
    (sigma1**2 / n1) + (sigma2**2 / n2)
)
p_value = 2 * (1 - norm.cdf(abs(z)))
z_critical = norm.ppf(1 - alpha / 2)

print("Two-Sample Z-Test")
print("------------------")
print("Mean latency of Model A =", x1, "ms")
print("Mean latency of Model B =", x2, "ms")
print("Z-statistic =", round(z, 4))
print("Critical Z-value =", round(z_critical, 4))
print("p-value =", round(p_value, 4))
if abs(z) > z_critical:
    print("Reject H0")
else:
    print("Fail to reject H0")
